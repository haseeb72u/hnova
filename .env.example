# ── SMTP credentials ─────────────────────────────────────
# Gmail example: use an App Password (not your login password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465, false for 587 (STARTTLS)
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password

# ── Email routing ─────────────────────────────────────────
# Who receives the contact form submissions
MAIL_TO=hello@hnova.tech
# How the "From" header appears in your inbox
MAIL_FROM="HNova Website <you@gmail.com>"

# ── Server ────────────────────────────────────────────────
PORT=3001

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production: https://hnova.tech
# Local dev:  http://localhost:3000,http://127.0.0.1:5500
ALLOWED_ORIGIN=http://localhost:3000
